{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "build": {
    "env": {
      "GO_BUILD_FLAGS": "-ldflags '-s -w'"
    }
  },
  "functions": {
    "cmd/server/main.go": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cloud-sources/sync",
      "schedule": "0 3 * * *"
    }
  ]
}
