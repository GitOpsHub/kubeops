APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
# Where a browser reaches this backend. Argo CD deep links are built against it
# because they are served by the built-in Argo CD proxy on this origin.
# Defaults to http://BACKEND_HOST:BACKEND_PORT.
PUBLIC_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://kubeops:kubeops@127.0.0.1:5432/kubeops?sslmode=disable
SYNC_INTERVAL=5m
SYNC_WORKERS=3
# Defaults to false on Vercel and true elsewhere. Manual syncs still execute
# inside their HTTP request when background workers are disabled.
BACKGROUND_WORKERS=true
CLOUD_SOURCES_FILE=../config/cloud-sources.yaml
# Serverless deployments can provide the contents of cloud-sources.yaml here.
# CLOUD_SOURCES_YAML=

# Cloud provider identity. Deployed environments federate the platform's OIDC
# token into a cloud role so no provider key is stored. auto federates when the
# platform supplies a token and otherwise falls back to each SDK's default
# credential chain, which locally resolves from ~/.aws, gcloud, and az logins.
# Accepts auto, vercel, or off.
CLOUD_IDENTITY_MODE=auto
# The aud claim the platform stamps into the token, https://vercel.com/<team>
# on Vercel. Every cloud's trust policy must accept this same value. Reported at
# startup so a mismatch is visible without waiting for a failed sync.
# CLOUD_IDENTITY_AUDIENCE=https://vercel.com/kubeops
# Deployed functions receive the token as the x-vercel-oidc-token request header
# rather than an environment variable. VERCEL_OIDC_TOKEN below is only for local
# development; `vercel env pull` writes it, and it lasts twelve hours.
# VERCEL_OIDC_TOKEN=

# Static provider credentials, used only by sources that do not configure
# federation. See the "Keyless cloud access" section of the README before
# setting these on a deployed environment.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# Google credentials are read from a file, so serverless deployments supply the
# document inline here instead and it is written to the temporary directory at
# startup. Accepts a service account key or a Workload Identity Federation
# external account configuration.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

GLOBAL_HELM_REPO_URL=ghcr.io/gitopshub/charts
GLOBAL_HELM_CHART=kubeops
GLOBAL_HELM_REVISION=1.1.0
GLOBAL_HELM_DEFAULT_VALUES_FILE=../charts/kubeops/values.yaml
# Serverless deployments can provide the contents of the Helm defaults here.
# GLOBAL_HELM_DEFAULT_VALUES_YAML=
GITHUB_ORG=GitOpsHub
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
GITHUB_DEFAULT_BRANCH=main
GITHUB_TOKEN=
# Optional alternative to GITHUB_TOKEN:
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_REPO_VISIBILITY=private
ARGO_PROJECT=default
ARGO_NAMESPACE=argo-cd
ARGO_TARGETS_FILE=../config/argo-targets.yaml
# Serverless deployments can provide the contents of argo-targets.yaml here.
# ARGO_TARGETS_YAML=
ARGO_POLL_INTERVAL=15s
ARGO_DEPLOYMENT_TIMEOUT=15m
ARGO_REQUEST_TIMEOUT=10s
# Required when a target configures UI access. Generate with: openssl rand -base64 32
ARGO_CREDENTIAL_ENCRYPTION_KEY=
# Optional read-only token used by local Argo CD to clone private GitOpsHub repositories.
ARGO_GITHUB_READ_TOKEN=
GITHUB_REPOSITORY_USERNAME=
# Each token named by config/argo-targets.yaml must be supplied as an environment variable.
# ARGO_PROD_US_EAST_TOKEN=
# ARGO_PROD_US_EAST_PASSWORD=
# Optional local bridge to an Argo CD instance running in a GKE cluster.
KUBEOPS_GKE_CONTEXT=
KUBEOPS_GKE_ARGO_PORT=18083
KUBEOPS_GKE_SOURCE_ID=
KUBEOPS_GKE_PROVIDER_RESOURCE_ID=
