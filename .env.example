APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api
DATABASE_URL=postgres://kubeops:kubeops@127.0.0.1:5432/kubeops?sslmode=disable
SYNC_INTERVAL=5m
SYNC_WORKERS=3
CLOUD_SOURCES_FILE=../config/cloud-sources.yaml
GLOBAL_HELM_REPO_URL=ghcr.io/gitopshub/charts
GLOBAL_HELM_CHART=kubeops
GLOBAL_HELM_REVISION=0.1.0
GLOBAL_HELM_DEFAULT_VALUES_FILE=../charts/kubeops/values.yaml
GITHUB_ORG=GitOpsHub
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=
# Optional alternative to GITHUB_TOKEN:
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_REPO_VISIBILITY=private
ARGO_PROJECT=default
ARGO_NAMESPACE=argo-cd
ARGO_TARGETS_FILE=../config/argo-targets.yaml
ARGO_POLL_INTERVAL=15s
ARGO_DEPLOYMENT_TIMEOUT=15m
ARGO_REQUEST_TIMEOUT=10s
# Required when a target configures UI access. Generate with: openssl rand -base64 32
ARGO_CREDENTIAL_ENCRYPTION_KEY=
# Optional read-only token used by local Argo CD to clone private GitOpsHub repositories.
ARGO_GITHUB_READ_TOKEN=
# Each token named by config/argo-targets.yaml must be supplied as an environment variable.
# ARGO_PROD_US_EAST_TOKEN=
# ARGO_PROD_US_EAST_PASSWORD=
