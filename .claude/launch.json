{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "./cmd/server"],
      "cwd": "backend",
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "database",
      "runtimeExecutable": "make",
      "runtimeArgs": ["dev-setup"],
      "port": 5432,
      "autoPort": false
    }
  ]
}
